# syntax=docker/dockerfile:1
FROM nginx:stable-alpine AS render

WORKDIR /build
COPY index.php ./index.php
COPY css/style.css ./css/style.css
COPY js/main.js ./js/main.js
ARG BUILD_VERSION

# Reject unexpected PHP instead of publishing it in the generated page.
RUN set -eu; \
    css_block="<?php echo @filemtime(__DIR__ . '/css/style.css'); ?>"; \
    js_block="<?php echo @filemtime(__DIR__ . '/js/main.js'); ?>"; \
    test "$(grep -Fo '<?php' index.php | wc -l)" -eq 2; \
    test "$(grep -Foc "$css_block" index.php)" -eq 1; \
    test "$(grep -Foc "$js_block" index.php)" -eq 1; \
    version="${BUILD_VERSION:-$(sha256sum css/style.css js/main.js | sha256sum | cut -c1-16)}"; \
    case "$version" in ''|*[!a-zA-Z0-9._-]*) echo 'Invalid BUILD_VERSION' >&2; exit 1;; esac; \
    awk -v css="$css_block" -v js="$js_block" -v version="$version" '\
        function replace_literal(text, needle, start) { \
            start = index(text, needle); \
            return start ? substr(text, 1, start - 1) version substr(text, start + length(needle)) : text; \
        } \
        { print replace_literal(replace_literal($0, css), js); }' index.php > index.html; \
    ! grep -Fq '<?' index.html

FROM nginx:stable-alpine

RUN rm -rf /usr/share/nginx/html/*
COPY docker/nginx.production.conf /etc/nginx/nginx.conf
COPY --from=render /build/index.html /usr/share/nginx/html/index.html
COPY css /usr/share/nginx/html/css
COPY js /usr/share/nginx/html/js
COPY img /usr/share/nginx/html/img
COPY favicon.ico summary-card.html Evgeny_Ilin_CV_PHP_Backend_Developer.pdf /usr/share/nginx/html/

USER nginx
EXPOSE 8080
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
